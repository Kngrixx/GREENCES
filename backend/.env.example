# Copia este archivo como .env (en la misma carpeta backend/) y llena tus datos.
# .env NO se sube a GitHub; este archivo de ejemplo si.

# Conexion a PostgreSQL: postgresql+psycopg://USUARIO:CONTRASENA@HOST:PUERTO/BASE
DATABASE_URL=postgresql+psycopg://postgres:TU_CONTRASENA@localhost:5432/greences

# Clave para firmar los tokens JWT: cualquier texto largo y dificil de adivinar.
JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-secreta

# Horas que dura un token antes de pedir login otra vez.
JWT_HORAS=8

# Origen(es) del frontend que pueden llamar a la API (separados por coma).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Segundos sin datos del ESP32 para mostrar el sistema como "sin datos recientes".
SEGUNDOS_EN_LINEA=20

# Puerto del servidor (el ESP32 envia a http://IP_DEL_PC:5000/api/lecturas).
PUERTO=5000

# 1 = modo desarrollo (se reinicia solo al guardar cambios y muestra errores detallados).
# Dejarlo en 0 al presentar: el servidor escucha en toda la red y el modo
# desarrollo expone una consola de depuracion.
FLASK_DEBUG=0

# Para que los comandos "flask db ..." encuentren la aplicacion.
FLASK_APP=run.py
